    {
      "parameters": {
        "jsCode": "const isDryRun = true;\nconst quoteNode = $item(0).$node['Jupiter Quote'].json;\nconst quote = quoteNode.body || quoteNode;\nconst candidate = $item(0).$node['Check Open Position'].json;\nconst entryPrice = Number(candidate.body?.price ?? candidate.price ?? 0);\nconst solAmountLamports = Number(quote.inAmount || 500000000);\nconst tokenAmountRaw = String(quote.outAmount || '0');\n\nif (!candidate.body?.tokenAddress && !candidate.tokenAddress) {\n  throw new Error('Missing tokenAddress from scanner payload');\n}\nif (!(entryPrice > 0)) {\n  throw new Error('Missing positive scanner entry price');\n}\nif (!(Number(tokenAmountRaw) > 0)) {\n  throw new Error('Jupiter quote returned empty outAmount');\n}\n\nif (isDryRun) {\n  return [{\n    json: {\n      tokenAddress: candidate.body?.tokenAddress || candidate.tokenAddress,\n      symbol: candidate.body?.symbol || candidate.symbol || 'UNKNOWN',\n      marketCap: Number(candidate.body?.marketCap ?? candidate.marketCap ?? 0),\n      liquidity: Number(candidate.body?.liquidity ?? candidate.liquidity ?? 0),\n      entryPrice,\n      entryTime: Date.now(),\n      solAmountLamports,\n      tokenAmountRaw,\n      txid: 'DRY_RUN_BUY_' + Date.now(),\n      isDryRun: true\n    }\n  }];\n}\n\nthrow new Error('LIVE_TRADING_NOT_IMPLEMENTED: add signing, RPC broadcast, and secret management before disabling dry run');"
      },
