        "jsCode": "const fs = require('fs');\nconst statePath = '/tmp/memebot_position.json';\nlet hasPosition = false;\ntry {\n  if (fs.existsSync(statePath)) {\n    const data = JSON.parse(fs.readFileSync(statePath, 'utf8'));\n    hasPosition = Boolean(data && data.tokenAddress);\n  }\n} catch (e) {}\n\nif (hasPosition) {\n  return [{ json: { canTrade: false, reason: 'OPEN_POSITION_EXISTS' } }];\n}\nreturn [{ json: { ...$json, canTrade: true } }];"
