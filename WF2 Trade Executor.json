        "jsCode": "const fs = require('fs');\nconst statePath = '/tmp/memebot_position.json';\nconst position = {\n  tokenAddress: $json.tokenAddress,\n  symbol: $json.symbol,\n  entryPrice: Number($json.entryPrice),\n  entryTime: Number($json.entryTime),\n  solAmountLamports: Number($json.solAmountLamports),\n  tokenAmountRaw: String($json.tokenAmountRaw),\n  txid: $json.txid,\n  isDryRun: Boolean($json.isDryRun)\n};\n\nif (!position.tokenAddress || !(position.entryPrice > 0) || !(Number(position.tokenAmountRaw) > 0)) {\n  throw new Error('Refusing to store incomplete position state');\n}\n\nfs.writeFileSync(statePath, JSON.stringify(position, null, 2));\nreturn [{ json: { ok: true, message: 'POSITION_OPENED', position } }];"
