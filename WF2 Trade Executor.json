    {
      "parameters": {
        "jsCode": "const isDryRun = true;\nconst quoteNode = $item(0).$node['Jupiter Quote'].json;\nconst quote = quoteNode.body || quoteNode;\nconst candidate = $item(0).$node['Check Open Position'].json;\n\n// REALISM UPDATE: Kai's feedback\n// In live trading, we enter late. Let's simulate this by adding 0.5% to 2% random slippage to the entry price.\nconst scanPrice = Number(candidate.body?.price ?? candidate.price ?? 0);\nconst simulatedSlippage = 1.005 + (Math.random() * 0.015); // 0.5% to 2% random penalty\nconst entryPrice = scanPrice * simulatedSlippage;\n\nconst solAmountLamports = Number(quote.inAmount || 700000000);\nconst tokenAmountRaw = String(quote.outAmount || '0');\n\nif (!candidate.body?.tokenAddress && !candidate.tokenAddress) {\n  throw new Error('Missing tokenAddress from scanner payload');\n}\nif (!(entryPrice > 0)) {\n  throw new Error('Missing positive scanner entry price');\n}\nif (!(Number(tokenAmountRaw) > 0)) {\n  throw new Error('Jupiter quote returned empty outAmount');\n}\n\nif (isDryRun) {\n  const marketCap = Number(candidate.body?.marketCap ?? candidate.marketCap ?? 0);\n  const liquidity = Number(candidate.body?.liquidity ?? candidate.liquidity ?? 0);\n\n  return [{\n    json: {\n      tokenAddress: candidate.body?.tokenAddress || candidate.tokenAddress,\n      symbol: candidate.body?.symbol || candidate.symbol || 'UNKNOWN',\n      marketCap,\n      liquidity,\n      volume1h: Number(candidate.body?.volume1h ?? candidate.volume1h ?? 0),\n      volume24h: Number(candidate.body?.volume24h ?? candidate.volume24h ?? 0),\n      candidateScore: Number(candidate.body?.candidateScore ?? candidate.candidateScore ?? 0),\n      entryPrice,\n      entryTime: Date.now(),\n      peakPrice: entryPrice,\n      solAmountLamports,\n      tokenAmountRaw,\n      txid: 'DRY_RUN_BUY_' + Date.now(),\n      isDryRun: true\n    }\n  }];\n}\n\nthrow new Error('LIVE_TRADING_NOT_IMPLEMENTED: add signing, RPC broadcast, and secret management before disabling dry run');"
      },
