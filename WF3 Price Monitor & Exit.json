    {
      "parameters": {
        "jsCode": "const exit = $item(0).$node['Evaluate Exit Rules'].json;\nconst quoteNode = $item(0).$node['Jupiter Quote Sell'].json;\nconst quote = quoteNode.body || quoteNode || {};\nconst outLamports = Number(quote.outAmount || 0);\nconst inLamports = Number(exit.solAmountLamports || exit.amount || 0);\n\n// In dry-run, always use the price-based PnL from Evaluate Exit Rules.\n// The Jupiter quote can differ from the Dexscreener price due to slippage\n// or timing, which would flip the sign and corrupt the trade log.\n// (e.g. a TAKE_PROFIT trade showing a negative PnL)\nconst priceBasedProfitLamports = Number(exit.profitLamports || 0);\n\n// For live mode: use real on-chain amounts (outLamports - inLamports).\n// For dry-run: use the price-based estimate which matches the exit reason.\nconst profitLamports = priceBasedProfitLamports;\n\nreturn [{\n  json: {\n    ...exit,\n    sellTxid: 'DRY_RUN_SELL_' + Date.now(),\n    profitLamports,\n    profit: profitLamports / 1e9,\n    isDryRun: true\n  }\n}];"
      },
