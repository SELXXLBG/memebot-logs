      "id": "8c9eb4d0-d2b7-42b3-9861-64c7e8a64b96",
      "name": "Price Status 200?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        13888,
        7456
      ]
    },
    {
      "parameters": {
        "jsCode": "const root = $json.body || $json;\nconst pairs = Array.isArray(root.pairs) ? root.pairs : [];\nconst position = $item(0).$node['Load Open Position'].json;\nconst pair = pairs\n  .filter(p => String(p.chainId || '').toLowerCase() === 'solana')\n  .sort((a, b) => Number(b.liquidity?.usd || 0) - Number(a.liquidity?.usd || 0))[0] || null;\n\nif (!pair) {\n  return [{ json: { ...position, shouldExit: 0, reason: 'NO_PRICE_DATA' } }];\n}\n\nconst entryPrice = Number(position.entryPrice || 0);\nconst currentPrice = Number(pair.priceUsd || 0);\nconst now = Date.now();\nconst maxHoldMs = 12 * 60 * 60 * 1000;\nconst elapsed = now - Number(position.entryTime || now);\n\nif (!(entryPrice > 0) || !(currentPrice > 0)) {\n  return [{ json: { ...position, entryPrice, exitPrice: currentPrice, shouldExit: 0, reason: 'INVALID_PRICE_DATA' } }];\n}\n\nlet shouldExit = 0;\nlet reason = 'HOLD';\n\nif (currentPrice >= entryPrice * 1.10) {\n  shouldExit = 1;\n  reason = 'TAKE_PROFIT_10P';\n} else if (currentPrice <= entryPrice * 0.85) {\n  shouldExit = 1;\n  reason = 'STOP_LOSS_15P';\n} else if (elapsed > maxHoldMs) {\n  shouldExit = 1;\n  reason = 'FORCE_EXIT_12H';\n}\n\nconst pnlPct = ((currentPrice - entryPrice) / entryPrice) * 100;\nconst solAmountLamports = Number(position.solAmountLamports || position.amount || 0);\nconst profitLamports = Math.floor(solAmountLamports * (pnlPct / 100));\n\nreturn [{\n  json: {\n    ...position,\n    entryPrice,\n    exitPrice: currentPrice,\n    profitLamports,\n    profit: profitLamports / 1e9,\n    pnlPct,\n    reason,\n    shouldExit\n  }\n}];"
      },
