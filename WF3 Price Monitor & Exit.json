      "parameters": {
        "jsCode": "const fs = require('fs');\nconst statePath = '/tmp/memebot_position.json';\nlet position = null;\ntry {\n  if (fs.existsSync(statePath)) {\n    position = JSON.parse(fs.readFileSync(statePath, 'utf8'));\n  }\n} catch (e) {}\n\nif (!position || !position.tokenAddress) {\n  return [{ json: { hasPosition: false } }];\n}\nreturn [{ json: { hasPosition: true, ...position } }];"
      },
