    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst statePath = '/tmp/memebot_position.json';\nconst cooldownPath = '/tmp/memebot_token_cooldown.json';\nconst trade = $node['Build Trade Log'].json.logLine || {};\n\ntry {\n  let cooldown = {};\n  try {\n    cooldown = JSON.parse(fs.readFileSync(cooldownPath, 'utf8'));\n  } catch (e) {}\n  if (trade.token) cooldown[trade.token] = Date.now();\n  fs.writeFileSync(cooldownPath, JSON.stringify(cooldown, null, 2));\n} catch (e) {}\n\ntry {\n  if (fs.existsSync(statePath)) fs.unlinkSync(statePath);\n} catch (e) {}\nreturn [{ json: { ok: true, message: 'LOGGED_AND_POSITION_CLEARED' } }];"
      },
