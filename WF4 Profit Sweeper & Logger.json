    {
      "parameters": {
        "jsCode": "\nconst payload = $json.body || $json;\nconst storageWallet = 'B12z9uHALwceTy1vdeEs2XBQfa79fvsWMM6sJGyPCKyQ';\n\n// PROFIT SWEEP LOGIC\nconst profitLamports = Number(payload.profitLamports || 0);\nconst isProfit = profitLamports > 0;\n\nreturn [{\n  json: {\n    ...payload,\n    storageWallet,\n    sweepAmountLamports: isProfit ? profitLamports : 0,\n    sweepTxid: isProfit ? 'DRY_RUN_SWEEP_TO_' + storageWallet.slice(0,6) + '_' + Date.now() : null,\n    sweepStatus: isProfit ? 'SUCCESS_SWEPT' : 'NO_PROFIT_TO_SWEEP'\n  }\n}];\n"
      },
      "id": "6899fd64-728c-4504-8e51-8faaa5b6c59d",
      "name": "Sweep Profit Transfer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        17680,
        10448
      ]
    },
    {
      "parameters": {
        "jsCode": "const src = $json.body || $json;\nconst now = new Date();\nconst day = now.toISOString().slice(0, 10);\nconst isDryRun = Boolean(src.isDryRun ?? true);\nconst logLine = {\n  status: isDryRun ? '[SIMULATION]' : '[LIVE]',\n  timestamp: now.toISOString(),\n  token: src.tokenAddress,\n  symbol: src.symbol || 'UNKNOWN',\n  marketCap: Number(src.marketCap || 0),\n  liquidity: Number(src.liquidity || 0),\n  volume1h: Number(src.volume1h || 0),\n  volume24h: Number(src.volume24h || 0),\n  candidateScore: Number(src.candidateScore || 0),\n  entryPrice: Number(src.entryPrice || 0),\n  exitPrice: Number(src.exitPrice || 0),\n  peakPrice: Number(src.peakPrice || 0),\n  profitSOL: Number(src.profit || 0),\n  profitLamports: Number(src.profitLamports || 0),\n  pnlPct: Number(src.pnlPct || 0),\n  peakPnlPct: Number(src.peakPnlPct || 0),\n  reason: src.reason,\n  buyTxid: src.txid || null,\n  sellTxid: src.sellTxid || null,\n  sweepTxid: src.sweepTxid || null\n};\n\nreturn [{ json: { ...src, tradeDate: day, githubPath: 'trades/' + day + '.json', logLine } }];"
      },
