      "id": "95453aab-35a2-431c-bb3a-d4164afad4d4",
      "name": "Profit >= 0?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        16240,
        6560
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst payload = $json.body || $json;\nconst storageWallet = 'B12z9uHALwceTy1vdeEs2XBQfa79fvsWMM6sJGyPCKyQ';\n\n// PROFIT SWEEP LOGIC\nconst profitLamports = Number(payload.profitLamports || 0);\nconst isProfit = profitLamports > 0;\n\nreturn [{\n  json: {\n    ...payload,\n    storageWallet,\n    sweepAmountLamports: isProfit ? profitLamports : 0,\n    sweepTxid: isProfit ? 'DRY_RUN_SWEEP_TO_' + storageWallet.slice(0,6) + '_' + Date.now() : null,\n    sweepStatus: isProfit ? 'SUCCESS_SWEPT' : 'NO_PROFIT_TO_SWEEP'\n  }\n}];\n"
      },
      "id": "8b14b6c5-1dc6-4762-9ebe-7a341ae9e5bf",
      "name": "Sweep Profit Transfer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16480,
        6448
      ]
    },
    {
      "parameters": {
        "jsCode": "const src = $json.body || $json;\nconst now = new Date();\nconst day = now.toISOString().slice(0, 10);\nconst isDryRun = Boolean(src.isDryRun ?? true);\nconst logLine = {\n  status: isDryRun ? '[SIMULATION]' : '[LIVE]',\n  timestamp: now.toISOString(),\n  token: src.tokenAddress,\n  symbol: src.symbol || 'UNKNOWN',\n  entryPrice: Number(src.entryPrice || 0),\n  exitPrice: Number(src.exitPrice || 0),\n  profitSOL: Number(src.profit || 0),\n  profitLamports: Number(src.profitLamports || 0),\n  pnlPct: Number(src.pnlPct || 0),\n  reason: src.reason,\n  buyTxid: src.txid || null,\n  sellTxid: src.sellTxid || null,\n  sweepTxid: src.sweepTxid || null\n};\n\nreturn [{ json: { ...src, tradeDate: day, githubPath: 'trades/' + day + '.json', logLine } }];"
      },
