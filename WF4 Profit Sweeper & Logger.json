    {
      "parameters": {
        "jsCode": "const getFileResult = $node['GitHub Get Daily File'].json;\nconst sha = getFileResult?.sha || getFileResult?.body?.sha || getFileResult?.data?.sha || '';\nconst content = getFileResult?.content || getFileResult?.body?.content || getFileResult?.data?.content || '';\n\nlet existingTrades = [];\nif (content) {\n  try {\n    const normalizedContent = String(content).split(String.fromCharCode(10)).join('');\n    const decoded = Buffer.from(normalizedContent, 'base64').toString('utf-8').trim();\n    const parsed = decoded ? JSON.parse(decoded) : [];\n    existingTrades = Array.isArray(parsed) ? parsed : [];\n  } catch (e) {\n    existingTrades = [];\n  }\n}\n\nconst newEntry = $node['Build Trade Log'].json.logLine;\nexistingTrades.push(newEntry);\n\nreturn [{\n  json: {\n    fileContent: Buffer.from(JSON.stringify(existingTrades, null, 2)).toString('base64'),\n    commitMessage: 'trade: ' + (newEntry.symbol || 'unknown') + ' | ' + (newEntry.reason || '?'),\n    githubPath: $node['Build Trade Log'].json.githubPath,\n    existingSha: (sha && sha !== 'undefined') ? sha : null\n  }\n}];"
      },
